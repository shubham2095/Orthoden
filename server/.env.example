PORT=5000
# Gmail account used to send the contact-form emails
EMAIL_USER=your-gmail-address@gmail.com
# Gmail App Password (not your normal password)
EMAIL_PASS=your-gmail-app-password
# Inbox that receives the appointment requests
EMAIL_TO=clinic-inbox@example.com
# Number of reverse proxies in front of the app (1 on most hosts). Needed so the
# contact-form rate limit works per visitor. Leave unset when running locally.
# TRUST_PROXY=1
# Optional: restrict API access to your site, e.g. https://www.yourclinic.com
# CORS_ORIGIN=
