# Copy this file to `.env` (same folder) and fill in the values.
# `.env` is gitignored and must never be committed.

# development locally, production on your host
NODE_ENV=development

# Port the Express server listens on
PORT=5000

# Public address of the website (no trailing slash). Used for sitemap.xml and robots.txt.
SITE_URL=http://localhost:5000

# Gmail address that will SEND the appointment emails
EMAIL_USER=your-gmail@gmail.com

# Gmail App Password (NOT your normal Gmail password) for EMAIL_USER
# Create one at https://myaccount.google.com/apppasswords (needs 2-Step Verification)
EMAIL_PASS=your-gmail-app-password

# Address that should RECEIVE appointment emails
EMAIL_TO=clinic-inbox@example.com

# Number of reverse proxies in front of the app. Defaults to 1 in production and off locally.
# Needed so the contact-form rate limit works per visitor.
# TRUST_PROXY=1
